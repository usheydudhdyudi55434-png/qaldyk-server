# Copy to .env and fill in. .env is git-ignored; never commit real values.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram bot: token from @BotFather, username without @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=qaldyk_bot

# Named Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Django: a long random key; DEBUG=1 lets runserver serve static files and photos
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# PostgreSQL password, used by both the postgres and django containers
POSTGRES_PASSWORD=

# Current quick tunnel host (without https://); after changing: docker compose up -d django telegram-bot
TUNNEL_HOST=
