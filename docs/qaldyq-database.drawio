<mxfile host="app.diagrams.net"><diagram id="qaldyq-db" name="Qaldyq DB"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="legend" value="&lt;b&gt;Qaldyq — дерекқор құрылымы (PostgreSQL: qaldyk_db)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; Қала: аудан, контейнер, датчик &amp;nbsp; &lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; Қызметкерлер &amp;nbsp; &lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; Өтініштер &amp;nbsp; &lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; Эко-ұпай мен ОСИ &amp;nbsp; &lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; Сенбілік &amp;nbsp; &lt;font color=&quot;#666666&quot;&gt;■&lt;/font&gt; Push-хабарлама&lt;br&gt;PK — бастапқы кілт, FK — сыртқы кілт, UQ — бірегей. Сызық: көп ──&amp;lt; бір" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="-90" width="1200" height="70" as="geometry"/></mxCell><mxCell id="user" value="auth_user" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="290" height="140" as="geometry"/></mxCell><mxCell id="user_0" value="PK id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=12;fontStyle=1;" vertex="1" parent="user"><mxGeometry y="30" width="290" height="22" as="geometry"/></mxCell><mxCell id="user_1" value="username" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;ov