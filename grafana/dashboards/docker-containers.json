{
  "uid": "qaldyq-docker",
  "title": "Docker контейнерлерінің ресурстары",
  "description": "cAdvisor → Prometheus → Grafana: Qaldyq жобасының контейнерлері",
  "tags": [
    "qaldyq",
    "docker",
    "cadvisor"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Контейнер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{name=~\".+\"}, name)",
          "refId": "containers"
        },
        "definition": "label_values(container_last_seen{name=~\".+\"}, name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Жалпы шолу",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Жұмыстағы контейнерлер",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(time() - container_last_seen{name=~\".+\"} < 60)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Соңғы 60 секундта cAdvisor көрген контейнерлер саны."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU, хосттан %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
